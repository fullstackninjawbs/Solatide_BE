PORT=5000
MONGO_URI=mongodb://localhost:27017/solatide
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ── Security / infrastructure ────────────────────────────────────────────────
# In production JWT_SECRET must be >= 32 random chars (server refuses to start otherwise).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Number of reverse-proxy hops to trust for X-Forwarded-For (express 'trust proxy').
# 1 = a single nginx in front (default). Use 2 if Cloudflare -> nginx -> node.
TRUST_PROXY=1

# Redis (shared cache + rate limiter store across PM2 workers). Leave unset to use a
# local redis://127.0.0.1:6379; set to "disabled" to turn Redis off (memory rate limits).
REDIS_URL=redis://127.0.0.1:6379

# Shared secret for the Starshipit webhook (POST /api/v1/orders/webhook/starshipit).
# Configure the webhook URL in Starshipit as
#   https://<api-host>/api/v1/orders/webhook/starshipit?token=<this value>
# or send it in the `x-starshipit-secret` header. If unset, the webhook is rejected (503).
STARSHIPIT_WEBHOOK_SECRET=

# Optional: max number of super_admin/admin accounts (default 3)
MAX_ADMIN_USERS=3

# Seed script (npm run seed) — never run against production.
# SEED_ADMIN_PASSWORD is required (>= 16 chars) and is never printed.
SEED_ADMIN_EMAIL=admin@solatide.com
SEED_ADMIN_PASSWORD=
# SEED_ALLOW_PRODUCTION=yes   # only if you really mean it (deletes all products)

# ── Background jobs (BullMQ on the same Redis as REDIS_URL) ──────────────────
# Order side effects, emails and storefront rebuilds run as retried background jobs.
# If Redis is unavailable (or QUEUES_ENABLED=false) everything falls back to in-process.
QUEUES_ENABLED=true
# Where workers run: api (first PM2 API instance, default) | separate (dist/worker.js as its own PM2 app) | off
RUN_WORKERS=api
# Timezone for the schedules below
SCHEDULE_TZ=Australia/Melbourne

# Scheduled jobs — each is OFF unless its cron pattern is set (5-field cron)
# Refresh Starshipit tracking for open shipments, e.g. every 30 min: */30 * * * *
STARSHIPIT_TRACKING_CRON=
# Database backup with mongodump, e.g. nightly 3am: 0 3 * * *
BACKUP_CRON=
# READ-ONLY database user for backups (never the app's read/write user)
BACKUP_MONGO_URI=
BACKUP_DIR=/var/backups/solatide-mongo
# Path to mongodump if not on PATH, e.g. /root/mongo-tools/bin/mongodump
MONGODUMP_PATH=
# One reminder email per unpaid checkout, e.g. every 15 min: */15 * * * *
ABANDONED_REMINDER_CRON=
ABANDONED_REMINDER_DELAY_HOURS=2

# Low-stock alert email (sent when an order takes an item from above the threshold to at/below it)
# Store-wide threshold; a product's own "Low stock threshold" overrides it only if changed from 5
LOW_STOCK_THRESHOLD=5
# Recipient (defaults to ADMIN_NOTIFICATION_EMAIL)
LOW_STOCK_ALERT_EMAIL=

# ── Order request checkout ───────────────────────────────────────────────────
# The checkout is chosen in Admin → Settings → Checkout mode. This flag only applies until a
# mode has been saved there. Order Request: details + cart are emailed to
# ADMIN_NOTIFICATION_EMAIL, the customer gets a confirmation. No order/stock change.
ORDER_REQUEST_CHECKOUT=false
# Shipping shown on the order-request page (AUD). Leave empty for "To be confirmed".
ORDER_REQUEST_SHIPPING_AU=
ORDER_REQUEST_SHIPPING_INTL=
ORDER_REQUEST_FREE_SHIPPING_FROM_AU=
